{
	email {$ACME_EMAIL}
	auto_https off
}

http://{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

http://www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	tls /etc/caddy/certs/luwag.shop_bundle.crt /etc/caddy/certs/luwag.shop.key
	encode zstd gzip

	# Request log for the 5xx rate and the Next image-cache hit ratio
	# (`x-nextjs-cache`). Rolled at 50MiB, 5 files kept, so the ceiling is
	# 250MiB on the data volume. Query strings are kept because the image
	# optimizer encodes its width there; nothing secret travels in them.
	log {
		output file /data/access.log {
			roll_size 50MiB
			roll_keep 5
			roll_keep_for 14d
		}
		format json
	}

	@admin_media_upload path /api/v1/admin/uploads
	handle @admin_media_upload {
		request_body {
			max_size 100MiB
		}
		reverse_proxy backend:3000 {
			request_buffers 100MiB
		}
	}

	@api path /api/v1 /api/v1/*
	handle @api {
		reverse_proxy backend:3000
	}

	@uploads path /uploads /uploads/*
	handle @uploads {
		reverse_proxy backend:3000 {
			header_down Cache-Control "public, max-age=31536000, immutable"
		}
	}

	handle {
		reverse_proxy frontend:3000
	}
}

www.{$DOMAIN} {
	tls /etc/caddy/certs/luwag.shop_bundle.crt /etc/caddy/certs/luwag.shop.key
	redir https://{$DOMAIN}{uri} permanent
}
