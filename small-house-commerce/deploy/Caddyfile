{
	email {$ACME_EMAIL}
	auto_https off
}

http://{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

http://www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	tls /etc/caddy/certs/luwag.shop_bundle.crt /etc/caddy/certs/luwag.shop.key
	encode zstd gzip

	@admin_media_upload path /api/v1/admin/uploads
	handle @admin_media_upload {
		request_body {
			max_size 100MiB
		}
		reverse_proxy backend:3000 {
			request_buffers 100MiB
		}
	}

	@api path /api/v1 /api/v1/*
	handle @api {
		reverse_proxy backend:3000
	}

	@uploads path /uploads /uploads/*
	handle @uploads {
		reverse_proxy backend:3000 {
			header_down Cache-Control "public, max-age=31536000, immutable"
		}
	}

	handle {
		reverse_proxy frontend:3000
	}
}

www.{$DOMAIN} {
	tls /etc/caddy/certs/luwag.shop_bundle.crt /etc/caddy/certs/luwag.shop.key
	redir https://{$DOMAIN}{uri} permanent
}
