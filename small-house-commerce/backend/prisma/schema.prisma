// Prisma schema for the Small House Ecommerce Platform.
//
// This is the Phase 1 connection foundation only — no models are defined yet.
// Models land alongside their feature modules, following docs/DATABASE.md.
//
// The connection URL lives in prisma7.config.ts (Prisma 7 moved it out of the
// `datasource` block); that file reads DATABASE_URL from .env.
//
// The client is generated into src/ on purpose: tsconfig.build.json pins
// rootDir to ./src, so anything generated outside it fails to compile.
// Import it as `../generated/prisma/client.js`.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
