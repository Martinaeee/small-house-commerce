// Orders, order items, payments, attribution and audit history, plus the
// inventory core (warehouses, on-hand/reserved, reservations, movements).
//
// Sources:
//   docs/DATABASE.md §28-33 (warehouse, inventory, reservation, movements),
//     §37-45 (orders, items, address snapshot, history), §42 (payment
//     status), §49-53 (attribution, AID snapshot), DB-003 (snapshots)
//   docs/API_SPEC.md §18 (COD checkout), §22 (confirm/cancel)
//
// Inventory rules (decided with product owner):
//   - PDP shows out-of-stock state but Add to Cart stays enabled
//   - Cart may hold unavailable SKUs, flagged per item; checkout refuses
//     when any item is short
//   - Checkout re-validates every SKU and rejects the whole order on any
//     shortfall (no partial checkout)
//   - Order creation reserves stock (§30); cancel/deny releases it (§31)

enum OrderStatus {
  NEW
  PENDING
  QUESTION
  CONFIRMED
  ABNORMAL
  SHIPPING
  SIGNED
  CANCELLED
  DENIED
  AFTER_SALES
}

enum ConfirmationStatus {
  UNCONFIRMED
  NEEDS_REVIEW
  CONFIRMED
  REJECTED
}

enum PaymentStatus {
  COD_PENDING
  COLLECTED
  SETTLEMENT_PENDING
  SETTLED
  ONLINE_PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  COD
  AIRWALLEX
}

enum SourceType {
  FB_POST
  META_AD
  ORGANIC
  DIRECT
  EMAIL
  OTHER
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

enum ShipmentStatus {
  SHIPPING
  SIGNED
}

enum MovementType {
  PURCHASE_RECEIPT
  ORDER_RESERVED
  RESERVATION_RELEASED
  SHIPMENT
  RETURN_RESTOCK
  DAMAGED
  MANUAL_ADJUSTMENT
}

enum WarehouseStatus {
  ACTIVE
  DISABLED
}

/// §28 warehouses. V1 runs one Philippines warehouse but the schema allows
/// several (indexes and unique pairs are warehouse-aware).
model Warehouse {
  id        String          @id @default(uuid(7)) @db.Uuid
  name      String
  country   String          @default("PH")
  province  String?
  city      String?
  status    WarehouseStatus @default(ACTIVE)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  inventory          Inventory[]
  inventoryMovements InventoryMovement[]
  reservations       InventoryReservation[]
  shipments          Shipment[]

  @@map("warehouses")
}

/// §29 inventory. available = on_hand - reserved is computed, never stored.
model Inventory {
  id          String   @id @default(uuid(7)) @db.Uuid
  skuId       String   @map("sku_id") @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  onHand      Int      @default(0) @map("on_hand")
  reserved    Int      @default(0)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sku       Sku       @relation(fields: [skuId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([skuId, warehouseId])
  @@map("inventory")
}

/// §30 reservations: order creation reserves without touching on-hand.
model InventoryReservation {
  id          String            @id @default(uuid(7)) @db.Uuid
  orderId     String            @map("order_id") @db.Uuid
  skuId       String            @map("sku_id") @db.Uuid
  warehouseId String            @map("warehouse_id") @db.Uuid
  quantity    Int
  status      ReservationStatus @default(ACTIVE)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  order     Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sku       Sku       @relation(fields: [skuId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([skuId])
  @@map("inventory_reservations")
}

/// §33 every meaningful stock mutation is auditable.
model InventoryMovement {
  id            String       @id @default(uuid(7)) @db.Uuid
  skuId         String       @map("sku_id") @db.Uuid
  warehouseId   String       @map("warehouse_id") @db.Uuid
  movementType  MovementType @map("movement_type")
  quantity      Int
  referenceType String?      @map("reference_type")
  referenceId   String?      @map("reference_id")
  operatorId    String?      @map("operator_id") @db.Uuid
  reason        String?
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  sku       Sku       @relation(fields: [skuId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@index([skuId])
  @@index([referenceId])
  @@map("inventory_movements")
}

/// §38 orders. Status is split into three domains (§39): order, confirmation
/// and payment each get their own column instead of one overloaded field.
model Order {
  id            String   @id @default(uuid(7)) @db.Uuid
  orderNumber   String   @unique @map("order_number")
  customerId    String   @map("customer_id") @db.Uuid
  orderStatus   OrderStatus @default(NEW) @map("order_status")
  confirmationStatus ConfirmationStatus @default(UNCONFIRMED) @map("confirmation_status")
  paymentStatus PaymentStatus @default(COD_PENDING) @map("payment_status")
  currency      String   @default("PHP")
  subtotal      Decimal  @db.Decimal(10, 2)
  discountTotal Decimal  @map("discount_total") @db.Decimal(10, 2)
  shippingTotal Decimal  @map("shipping_total") @db.Decimal(10, 2)
  grandTotal    Decimal  @map("grand_total") @db.Decimal(10, 2)
  // AID snapshot (§53): copied at order creation, never recomputed.
  optimizerId         String? @map("optimizer_id") @db.Uuid
  optimizerAidSnapshot String? @map("optimizer_aid_snapshot")
  optimizerNameSnapshot String? @map("optimizer_name_snapshot")
  customerClassification String? @map("customer_classification")
  confirmedBy   String?  @map("confirmed_by") @db.Uuid
  confirmedAt   DateTime? @map("confirmed_at") @db.Timestamptz(3)
  confirmationNote String? @map("confirmation_note")
  // Customer-service assignment (order workbench): who is handling this order.
  assignedToId String?  @map("assigned_to_id") @db.Uuid
  assignedBy   String?  @map("assigned_by") @db.Uuid
  assignedAt   DateTime? @map("assigned_at") @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  preferredDeliveryDate DateTime? @map("preferred_delivery_date") @db.Date
  customerNote           String?   @map("customer_note")
  promoCode              String?   @map("promo_code")
  /// Browser session that placed the order (analytics_events.session_id).
  /// The dashboard's conversion rate divides ordering sessions by all
  /// sessions; the order row — not the PURCHASE pixel event — is the fact.
  trackingSessionId      String?   @map("tracking_session_id") @db.VarChar(100)
  // Manual COD verification (stage 1A): the checklist a handler works through.
  verificationRequired Boolean  @default(false) @map("verification_required")
  // When the handler should come back to this order (follow-up callback).
  nextFollowUpAt DateTime? @map("next_follow_up_at") @db.Timestamptz(3)

  customer        Customer                 @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items           OrderItem[]
  shippingAddress OrderShippingAddress?
  statusHistory   OrderStatusHistory[]
  notes           OrderNote[]
  riskFlags       OrderRiskFlag[]
  mergeRecordsPrimary  OrderMergeRecord[] @relation("PrimaryOrder")
  mergeRecordsMerged   OrderMergeRecord[] @relation("MergedOrder")
  attribution     OrderAttribution?
  payments        Payment[]
  reservations    InventoryReservation[]
  shipments       Shipment[]
  promoRedemption PromoCodeRedemption?
  verificationAssignments OrderVerificationAssignment[]
  verificationItems      OrderVerificationItem[]
  verificationEvents     OrderVerificationEvent[]
  verificationApprovals  OrderVerificationApproval[]
  handoverEvents         OrderHandoverEvent[]

  @@index([customerId])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@index([assignedToId])
  @@index([createdAt])
  @@index([trackingSessionId])
  @@index([nextFollowUpAt])
  @@map("orders")
}

/// §46 order notes — internal, append-only service notes (order workbench).
model OrderNote {
  id        String   @id @default(uuid(7)) @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  noteType  String   @map("note_type") // CUSTOMER_SERVICE / SYSTEM / WAREHOUSE
  content   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_notes")
}

/// §47 order risk flags — detection marks, never auto-delete the order.
model OrderRiskFlag {
  id         String   @id @default(uuid(7)) @db.Uuid
  orderId    String   @map("order_id") @db.Uuid
  flagType   String   @map("flag_type") // POSSIBLE_DUPLICATE / CUSTOMER_RECHECK / CUSTOMER_BLOCKED
  reason     String?
  resolved   Boolean  @default(false)
  createdBy  String?  @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([flagType, resolved])
  @@map("order_risk_flags")
}

/// §48 order merge records — merged history is never deleted.
model OrderMergeRecord {
  id             String   @id @default(uuid(7)) @db.Uuid
  primaryOrderId String   @map("primary_order_id") @db.Uuid
  mergedOrderId  String   @map("merged_order_id") @db.Uuid
  operatorId     String?  @map("operator_id") @db.Uuid
  reason         String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  primaryOrder Order @relation("PrimaryOrder", fields: [primaryOrderId], references: [id], onDelete: Restrict)
  mergedOrder  Order @relation("MergedOrder", fields: [mergedOrderId], references: [id], onDelete: Restrict)

  @@index([primaryOrderId])
  @@map("order_merge_records")
}

/// §61-62 shipments. One Order may contain multiple shipments — never assume
/// 1 order = 1 tracking number (§61). A partial shipment ships a subset of
/// the order's line quantities; the order stays SHIPPING until every shipment
/// is SIGNED (§69, DATABASE.md §2177-2205).
model Shipment {
  id             String         @id @default(uuid(7)) @db.Uuid
  orderId        String         @map("order_id") @db.Uuid
  warehouseId    String         @map("warehouse_id") @db.Uuid
  carrier        String
  trackingNumber String?        @map("tracking_number")
  status         ShipmentStatus @default(SHIPPING)
  shippingCost   Decimal?       @map("shipping_cost") @db.Decimal(10, 2)
  shippedAt      DateTime       @map("shipped_at") @db.Timestamptz(3)
  signedAt       DateTime?      @map("signed_at") @db.Timestamptz(3)
  createdBy      String?        @map("created_by") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  order     Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items     ShipmentItem[]

  @@index([orderId])
  @@map("shipments")
}

/// §63 shipment items — which order lines (and how much) went in each box.
model ShipmentItem {
  id          String    @id @default(uuid(7)) @db.Uuid
  shipmentId  String    @map("shipment_id") @db.Uuid
  orderItemId String    @map("order_item_id") @db.Uuid
  quantity    Int

  shipment  Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([shipmentId])
  @@map("shipment_items")
}

/// §43 order items with historical snapshots (DB-003): catalog changes never
/// alter past orders.
model OrderItem {
  id                  String  @id @default(uuid(7)) @db.Uuid
  orderId             String  @map("order_id") @db.Uuid
  productId           String? @map("product_id") @db.Uuid
  variantId           String? @map("variant_id") @db.Uuid
  skuId               String  @map("sku_id") @db.Uuid
  productNameSnapshot String  @map("product_name_snapshot")
  skuCodeSnapshot     String  @map("sku_code_snapshot")
  variantSnapshot     String  @map("variant_snapshot")
  optionSnapshot      Json?   @map("option_snapshot")
  bundleSnapshot      Json?   @map("bundle_snapshot") @db.JsonB
  quantity            Int
  unitPrice           Decimal @map("unit_price") @db.Decimal(10, 2)
  unitDiscount        Decimal @map("unit_discount") @db.Decimal(10, 2)
  unitCostSnapshot    Decimal? @map("unit_cost_snapshot") @db.Decimal(10, 2)
  lineTotal           Decimal @map("line_total") @db.Decimal(10, 2)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku   Sku   @relation(fields: [skuId], references: [id], onDelete: Restrict)

  shipmentItems ShipmentItem[]

  @@index([orderId])
  @@index([productId])
  // Filtering the order list by SKU / product needs this index.
  @@index([skuId])
  @@map("order_items")
}

/// §44 address snapshot, independent from the customer's current addresses.
model OrderShippingAddress {
  id            String  @id @default(uuid(7)) @db.Uuid
  orderId       String  @unique @map("order_id") @db.Uuid
  fullName      String  @map("full_name")
  phone         String
  province      String
  city          String
  barangay      String?
  postalCode    String? @map("postal_code")
  streetAddress String  @map("street_address")
  landmark      String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([province])
  @@map("order_shipping_address")
}

/// §45 every important state change is recorded.
model OrderStatusHistory {
  id          String  @id @default(uuid(7)) @db.Uuid
  orderId     String  @map("order_id") @db.Uuid
  statusDomain String @map("status_domain")
  oldStatus   String? @map("old_status")
  newStatus   String  @map("new_status")
  source      String
  operatorId  String? @map("operator_id") @db.Uuid
  comment     String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_history")
}

/// §51 attribution snapshot. Traffic attribution survives browsing (§52) and
/// the AID is frozen at order creation (§53). Facebook/landing fields stay
/// plain columns until those modules land (Phase 4), then FKs can be added.
model OrderAttribution {
  id                     String     @id @default(uuid(7)) @db.Uuid
  orderId                String     @unique @map("order_id") @db.Uuid
  sourceType             SourceType @map("source_type")
  optimizerId            String?    @map("optimizer_id") @db.Uuid
  aidSnapshot            String?    @map("aid_snapshot")
  ownerNameSnapshot      String?    @map("owner_name_snapshot")
  linkId                 String?    @map("link_id") @db.Uuid
  productId              String?    @map("product_id") @db.Uuid
  productNameSnapshot    String?    @map("product_name_snapshot")
  productCodeSnapshot    String?    @map("product_code_snapshot")
  publishedRevision      Int?       @map("published_revision")
  touchedAt              DateTime?  @map("touched_at") @db.Timestamptz(3)
  legacy                 Boolean?
  facebookPageId         String?    @map("facebook_page_id")
  facebookPostId         String?    @map("facebook_post_id")
  facebookPostTrackingCode String?  @map("facebook_post_tracking_code")
  campaignId             String?    @map("campaign_id")
  adsetId                String?    @map("adset_id")
  adId                   String?    @map("ad_id")
  landingPageId          String?    @map("landing_page_id")
  utmSource              String?    @map("utm_source")
  utmMedium              String?    @map("utm_medium")
  utmCampaign            String?    @map("utm_campaign")
  utmContent             String?    @map("utm_content")
  utmTerm                String?    @map("utm_term")
  fbclid                 String?
  attributedAt           DateTime   @default(now()) @map("attributed_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  link  CampaignLink? @relation(fields: [linkId], references: [id], onDelete: Restrict)

  @@index([linkId, touchedAt])
  @@index([landingPageId, touchedAt])
  @@index([optimizerId, touchedAt])
  @@map("order_attributions")
}

/// Payments are their own table (decided in COMMERCE_MODEL_MAPPING.md Q4);
/// Order.paymentStatus stays as the denormalised current state.
model Payment {
  id        String        @id @default(uuid(7)) @db.Uuid
  orderId   String        @map("order_id") @db.Uuid
  method    PaymentMethod
  status    PaymentStatus @default(COD_PENDING)
  amount    Decimal       @db.Decimal(10, 2)
  reference String?
  paidAt    DateTime?     @map("paid_at") @db.Timestamptz(3)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Manual COD verification (stage 1A).
//
// A COD order is only confirmable once a human verified every applicable
// mandatory item. The model is deliberately split into
//   - one assignment   (who owns the order, priority, next follow-up)
//   - one item per question (stable key, required-ness, current result)
//   - an append-only event log (every action and every contact attempt)
//   - one approval row (the basis a human confirmed on)
// Nothing here rewrites order history: rows are appended, results are
// superseded by newer events, and a changed order invalidates the affected
// results instead of deleting them.
// ---------------------------------------------------------------------------

enum VerificationCategory {
  CUSTOMER_INFO
  PRODUCT_INFO
  SHIPPING_ADDRESS
  COD_PAYMENT
  DELIVERY_SCHEDULE
  RISK_REVIEW
  OTHER
}

enum VerificationItemStatus {
  PENDING
  DONE
  PROBLEM
  SKIPPED
  INVALIDATED
}

enum VerificationEventType {
  ASSIGNED
  REASSIGNED
  RESULT_SET
  CONTACT_ATTEMPT
  NOTE
  NEXT_FOLLOW_UP
  INVALIDATED
  SKIPPED
}

enum VerificationPriority {
  NORMAL
  HIGH
  URGENT
}

enum VerificationTemplateScope {
  SYSTEM
  CUSTOM
}

/// One current assignment per order. Reassignment closes the old row and
/// opens a new one, so the checklist and its history are never lost.
model OrderVerificationAssignment {
  id              String               @id @default(uuid(7)) @db.Uuid
  orderId         String               @map("order_id") @db.Uuid
  assigneeId      String?              @map("assignee_id") @db.Uuid
  assignedById    String               @map("assigned_by_id") @db.Uuid
  assignedAt      DateTime             @default(now()) @map("assigned_at") @db.Timestamptz(3)
  closedAt        DateTime?            @map("closed_at") @db.Timestamptz(3)
  priority        VerificationPriority @default(NORMAL)
  nextFollowUpAt  DateTime?            @map("next_follow_up_at") @db.Timestamptz(3)
  note            String?
  /// Optimistic lock: a stale write is rejected instead of overwriting.
  rev             Int                  @default(1)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  order     Order                      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items     OrderVerificationItem[]
  events    OrderVerificationEvent[]
  approvals OrderVerificationApproval[]

  @@index([orderId])
  @@index([assigneeId, closedAt])
  @@index([nextFollowUpAt])
  @@map("order_verification_assignments")
}

/// One verification question on an order. itemKey is the stable identity
/// (e.g. "addr_area"); business rules never key off the display title.
model OrderVerificationItem {
  id             String                  @id @default(uuid(7)) @db.Uuid
  orderId        String                  @map("order_id") @db.Uuid
  assignmentId   String?                 @map("assignment_id") @db.Uuid
  itemKey        String                  @map("item_key")
  category       VerificationCategory
  titleSnapshot  String                  @map("title_snapshot")
  required       Boolean                 @default(true)
  // The person who checks this question. It can differ from the owner of the
  // order, so a question can be handed to somebody else.
  assigneeId     String?                 @map("assignee_id") @db.Uuid
  status         VerificationItemStatus  @default(PENDING)
  result         String?
  note           String?
  operatorId     String?                 @map("operator_id") @db.Uuid
  completedAt    DateTime?               @map("completed_at") @db.Timestamptz(3)
  nextFollowUpAt DateTime?               @map("next_follow_up_at") @db.Timestamptz(3)
  skippedReason  String?                 @map("skipped_reason")
  /// Fingerprint of the fields this question depends on. When the order is
  /// edited and the fingerprint no longer matches, the result is invalidated
  /// and has to be verified again.
  subjectFingerprint String?              @map("subject_fingerprint")
  invalidatedAt  DateTime?               @map("invalidated_at") @db.Timestamptz(3)
  invalidatedReason String?               @map("invalidated_reason")
  rev            Int                     @default(1)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  order      Order                     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  assignment OrderVerificationAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  events     OrderVerificationEvent[]

  @@unique([orderId, itemKey])
  @@index([orderId, status])
  @@map("order_verification_items")
}

/// Append-only log: every assignment, every contact attempt, every result.
model OrderVerificationEvent {
  id           String                  @id @default(uuid(7)) @db.Uuid
  orderId      String                  @map("order_id") @db.Uuid
  itemId       String?                 @map("item_id") @db.Uuid
  assignmentId String?                 @map("assignment_id") @db.Uuid
  type         VerificationEventType
  fromStatus   VerificationItemStatus? @map("from_status")
  toStatus     VerificationItemStatus? @map("to_status")
  result       String?
  note         String?
  operatorId   String?                 @map("operator_id") @db.Uuid
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)

  order      Order                      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item       OrderVerificationItem?     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  assignment OrderVerificationAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([itemId, createdAt])
  @@map("order_verification_events")
}

/// The basis a human confirmed on. Frozen so a later audit can see exactly
/// which results the approver saw.
model OrderVerificationApproval {
  id           String   @id @default(uuid(7)) @db.Uuid
  orderId      String   @map("order_id") @db.Uuid
  assignmentId String?  @map("assignment_id") @db.Uuid
  basis        Json
  snapshotHash String   @map("snapshot_hash")
  approvedById String   @map("approved_by_id") @db.Uuid
  approvedAt   DateTime @default(now()) @map("approved_at") @db.Timestamptz(3)

  order      Order                       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  assignment OrderVerificationAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  @@index([orderId, approvedAt])
  @@map("order_verification_approvals")
}

/// Reusable checklists. SYSTEM templates ship with the app; CUSTOM ones are
/// owned by the person who created them.
model VerificationItemTemplate {
  id        String                    @id @default(uuid(7)) @db.Uuid
  name      String
  scope     VerificationTemplateScope @default(SYSTEM)
  ownerId   String?                   @map("owner_id") @db.Uuid
  items     Json
  createdAt DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([scope])
  @@map("verification_item_templates")
}

// ---------------------------------------------------------------------------
// Handover events (stage 1A).
//
// "Handed over to the warehouse" is a fact, not a status: it has a real time,
// a real operator, a reason when the warehouse refuses or the customer
// withdraws, and it names the order lines and quantities that moved. This is
// deliberately not a warehouse-management system: no bins, no picking, no
// labels.
// ---------------------------------------------------------------------------

enum OrderHandoverEventType {
  HANDED_OVER
  REJECTED
  WITHDRAWN
}

enum OrderHandoverDisposition {
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model OrderHandoverEvent {
  id          String                   @id @default(uuid(7)) @db.Uuid
  orderId     String                   @map("order_id") @db.Uuid
  type        OrderHandoverEventType
  disposition OrderHandoverDisposition
  occurredAt  DateTime                 @default(now()) @map("occurred_at") @db.Timestamptz(3)
  operatorId  String                   @map("operator_id") @db.Uuid
  /// Required for REJECTED and WITHDRAWN.
  reason      String?
  note        String?
  /// [{ orderItemId, skuCodeSnapshot, quantity }] - the lines and quantities
  /// that actually moved, so a partial handover stays attached to the order.
  items       Json
  createdAt   DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, occurredAt])
  @@map("order_handover_events")
}
