// Catalog: categories, products, variants, SKUs, product media and suppliers.
//
// Sources:
//   docs/DATABASE.md §19-26 (Product System), §27 (Supplier System)
//   docs/SYSTEM_ARCHITECTURE.md catalog module (owns Product/Variant/SKU/
//     Category/Collection/ProductMedia; does NOT own inventory/orders/etc.)
//   Decisions: Category is a self-referencing tree (parentId); Supplier is
//     built now because SKU carries supplier fields (§22); Product status is
//     DRAFT/ACTIVE/DISABLED. §25 forbids packing structured attributes into
//     one JSON blob, so dimensions are structured columns.

enum ProductStatus {
  DRAFT
  ACTIVE
  DISABLED
}

enum ProductOptionKind {
  COLOR
  SIZE
  MATERIAL
  STYLE
}

enum ProductOptionPresentation {
  IMAGE
  SWATCH
  TEXT
}

enum SkuStatus {
  ACTIVE
  DISABLED
}

enum SupplierStatus {
  ACTIVE
  DISABLED
}

enum CategoryStatus {
  ACTIVE
  DISABLED
}

/// §26 "Room" merchandising dimension.
enum Room {
  BEDROOM
  STORAGE
  DINING_LIVING
  HOME_OFFICE
}

/// §26 "Solution" merchandising dimension. A product can have several.
enum Solution {
  FOLDABLE
  NARROW_SPACE
  MOBILE
  MULTIFUNCTIONAL
  HIDDEN_STORAGE
  RENTAL_FRIENDLY
}

/// §26 "Internal Product Role" merchandising dimension.
enum InternalProductRole {
  HERO
  CORE
  ENTRY
  PREMIUM
  PRE_ORDER
}

/// Product review source. ADMIN = merchant-entered for cold start;
/// CUSTOMER = post-order (submission/moderation ships in V1.5).
enum ReviewSource {
  ADMIN
  CUSTOMER
}

/// §27 suppliers. SKU rows reference this. Sensitive fields stay admin-only.
model Supplier {
  id             String        @id @default(uuid(7)) @db.Uuid
  name           String
  contact        String?
  sourcePlatform String?       @map("source_platform")
  supplierUrl    String?       @map("supplier_url")
  currency       String?
  status         SupplierStatus @default(ACTIVE)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  skus Sku[]

  @@map("suppliers")
}

/// Category tree. parentId nullable; a product belongs to one category.
model Category {
  id        String         @id @default(uuid(7)) @db.Uuid
  parentId  String?        @map("parent_id") @db.Uuid
  name      String
  slug      String         @unique
  sortOrder Int            @default(0) @map("sort_order")
  imageUrl  String?        @map("image_url")
  status    CategoryStatus @default(ACTIVE)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@map("categories")
}

/// §20 required data plus §23 furniture dimensions and §26 dimensions.
model Product {
  id             String              @id @default(uuid(7)) @db.Uuid
  name           String
  slug           String              @unique
  description    String?
  // First-screen one-line selling point under the H1; empty hides the row.
  tagline        String?
  categoryId     String              @map("category_id") @db.Uuid
  status         ProductStatus       @default(DRAFT)
  room           Room?
  internalRole   InternalProductRole? @map("internal_role")
  solutions      Solution[]
  // §23 furniture dimensions; folded_* nullable for non-foldable items.
  width          Float?              @db.DoublePrecision
  height         Float?              @db.DoublePrecision
  depth          Float?              @db.DoublePrecision
  foldedWidth    Float?              @map("folded_width") @db.DoublePrecision
  foldedHeight   Float?              @map("folded_height") @db.DoublePrecision
  foldedDepth    Float?              @map("folded_depth") @db.DoublePrecision
  // Structured specifications rendered from columns, never from description.
  materials               String?
  features                String?
  catalogGraphVersion     Int                 @default(0) @map("catalog_graph_version")
  defaultDisplayVariantId String?             @map("default_display_variant_id") @db.Uuid
  createdAt               DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  category              Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  defaultDisplayVariant ProductVariant? @relation("ProductDefaultDisplayVariant", fields: [defaultDisplayVariantId, id], references: [id, productId], onDelete: NoAction)
  images                ProductImage[]
  detailBlocks          ProductDetailBlock[]
  reviews               ProductReview[]
  landingPages          ProductLandingPage[]
  options               ProductOption[]
  variants              ProductVariant[] @relation("ProductVariants")
  skus                  Sku[]
  collections           CollectionProduct[]
  homepageSections      HomepageSectionProduct[]

  @@index([categoryId])
  @@index([status])
  @@map("products")
}

/// §20 "Media". Gallery entries are media, not just photos: `type` lets the
/// PDP gallery mix product shots with short videos (reuses DetailBlockType).
model ProductImage {
  id            String          @id @default(uuid(7)) @db.Uuid
  productId     String          @map("product_id") @db.Uuid
  optionValueId String?         @map("option_value_id") @db.Uuid
  variantId     String?         @map("variant_id") @db.Uuid
  url           String
  type          DetailBlockType @default(IMAGE)
  altText       String?         @map("alt_text")
  sortOrder     Int             @default(0) @map("sort_order")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  product     Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue? @relation(fields: [optionValueId, productId], references: [id, productId], onDelete: Cascade)
  variant     ProductVariant?     @relation(fields: [variantId, productId], references: [id, productId], onDelete: Cascade)

  @@index([productId])
  @@index([optionValueId, productId])
  @@index([variantId, productId])
  @@map("product_images")
}

/// What a PDP description block renders as. The supplier detail decks are
/// image/video led, so the block list is media-first by design.
enum DetailBlockType {
  IMAGE
  VIDEO
}

/// PDP description body, shown BELOW the gallery. `Product.description` stays
/// as the short text intro; this is the long, media-heavy part (1688-style
/// detail images and product videos), ordered by sortOrder.
model ProductDetailBlock {
  id        String          @id @default(uuid(7)) @db.Uuid
  productId String          @map("product_id") @db.Uuid
  type      DetailBlockType
  url       String
  altText   String?         @map("alt_text")
  sortOrder Int             @default(0) @map("sort_order")
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_detail_blocks")
}

/// Which kind of page a HeroStyle belongs to. Polymorphic on purpose: the same
/// knobs apply to categories and collections, and the storefront renders both
/// through one component (so the admin preview can reuse it too).
enum HeroOwnerType {
  CATEGORY
  COLLECTION
}

enum HeroBackgroundType {
  SOLID
  IMAGE
}

/// Per-page hero appearance (category and collection landing pages). One row
/// per owner; no row = the default: centered name on the page background.
/// Deliberately no relation — the owner lives in two different tables — so
/// readers fetch these by (ownerType, ownerId) and merge.
model HeroStyle {
  id        String        @id @default(uuid(7)) @db.Uuid
  ownerType HeroOwnerType @map("owner_type")
  ownerId   String        @map("owner_id") @db.Uuid
  /// Replaces the category/collection name when set.
  titleOverride String? @map("title_override")
  /// #rrggbb. Null = the theme's ink colour.
  titleColor    String? @map("title_color")
  /// Desktop px. The component clamps it to its safe range.
  titleSize     Int?    @map("title_size")
  /// Key into the frontend's fixed font set (brand | sans | serif).
  titleFont     String? @map("title_font")

  backgroundType     HeroBackgroundType @default(SOLID) @map("background_type")
  /// #rrggbb; only meaningful for SOLID (null = transparent).
  backgroundColor    String?            @map("background_color")
  backgroundImageUrl String?            @map("background_image_url")
  /// 0–24 px, applied to the background image LAYER only so text stays sharp.
  backgroundBlur     Int                @default(0) @map("background_blur")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([ownerType, ownerId])
  @@map("hero_styles")
}

model ProductOption {
  id            String                    @id @default(uuid(7)) @db.Uuid
  productId     String                    @map("product_id") @db.Uuid
  kind          ProductOptionKind
  name          String
  position      Int
  presentation  ProductOptionPresentation
  isMediaDriver Boolean                   @default(false) @map("is_media_driver")
  isActive      Boolean                   @default(true) @map("is_active")
  createdAt     DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  product       Product                     @relation(fields: [productId], references: [id], onDelete: Cascade)
  values        ProductOptionValue[]
  variantValues ProductVariantOptionValue[]

  @@unique([id, productId])
  @@index([productId])
  @@map("product_options")
}

model ProductOptionValue {
  id           String   @id @default(uuid(7)) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  optionId     String   @map("option_id") @db.Uuid
  label        String
  position     Int
  swatchHex    String?  @map("swatch_hex")
  thumbnailUrl String?  @map("thumbnail_url")
  thumbnailAlt String?  @map("thumbnail_alt")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  option        ProductOption                @relation(fields: [optionId, productId], references: [id, productId], onDelete: Cascade)
  images        ProductImage[]
  variantValues ProductVariantOptionValue[]

  @@unique([id, productId])
  @@unique([id, optionId, productId])
  @@index([optionId, productId])
  @@index([productId])
  @@map("product_option_values")
}

model ProductVariantOptionValue {
  variantId     String @map("variant_id") @db.Uuid
  productId     String @map("product_id") @db.Uuid
  optionId      String @map("option_id") @db.Uuid
  optionValueId String @map("option_value_id") @db.Uuid

  variant     ProductVariant     @relation(fields: [variantId, productId], references: [id, productId], onDelete: Cascade)
  option      ProductOption      @relation(fields: [optionId, productId], references: [id, productId], onDelete: Cascade)
  optionValue ProductOptionValue @relation(fields: [optionValueId, optionId, productId], references: [id, optionId, productId], onDelete: Cascade)

  @@id([variantId, optionId])
  @@index([optionId, productId])
  @@index([optionValueId, optionId, productId])
  @@map("product_variant_option_values")
}

/// §21: a sellable variation (e.g. Black / White / Wood). One variant is one
/// SKU, but the SKU stays a separate model because it carries cost and
/// package data the variant does not.
model ProductVariant {
  id             String   @id @default(uuid(7)) @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  name           String
  position       Int      @default(0)
  combinationKey String   @map("combination_key")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product            Product                     @relation("ProductVariants", fields: [productId], references: [id], onDelete: Cascade)
  defaultForProducts Product[]                   @relation("ProductDefaultDisplayVariant")
  images             ProductImage[]
  optionValues       ProductVariantOptionValue[]
  sku                Sku?

  @@unique([id, productId])
  @@unique([productId, name])
  @@unique([productId, combinationKey])
  @@index([productId])
  @@map("product_variants")
}

/// §22 SKU fields plus §24 package dimensions.
model Sku {
  id              String    @id @default(uuid(7)) @db.Uuid
  productId       String    @map("product_id") @db.Uuid
  variantId       String    @unique @map("variant_id") @db.Uuid
  skuCode         String    @unique @map("sku_code")
  status          SkuStatus @default(ACTIVE)
  // §22 supplier data
  supplierId      String?   @map("supplier_id") @db.Uuid
  supplierSku     String?   @map("supplier_sku")
  supplierCost    Decimal?  @map("supplier_cost") @db.Decimal(10, 2)
  costCurrency    String?   @map("cost_currency")
  landedCost      Decimal?  @map("landed_cost") @db.Decimal(10, 2)
  // Retail pricing in PHP (storefront currency). compareAtPrice is the
  // strikethrough "original price" shown on the PDP (§8 Price Module).
  price           Decimal?  @map("price") @db.Decimal(10, 2)
  compareAtPrice  Decimal?  @map("compare_at_price") @db.Decimal(10, 2)
  // §24 package dimensions - separate from product dimensions (§23)
  productWeight   Float?    @map("product_weight") @db.DoublePrecision
  packageWidth    Float?    @map("package_width") @db.DoublePrecision
  packageHeight   Float?    @map("package_height") @db.DoublePrecision
  packageDepth    Float?    @map("package_depth") @db.DoublePrecision
  packageWeight   Float?    @map("package_weight") @db.DoublePrecision
  volumetricWeight Float?   @map("volumetric_weight") @db.DoublePrecision
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  product  Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  supplier Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  cartItems CartItem[]
  inventory          Inventory[]
  reservations       InventoryReservation[]
  inventoryMovements InventoryMovement[]
  orderItems         OrderItem[]

  @@index([productId])
  @@index([supplierId])
  @@map("skus")
}

/// PDP_SPEC §22 reviews. Admin can seed reviews for cold start; customer
/// reviews arrive post-order in V1.5. Storefront reads isVisible rows only.
/// photos are image URLs (admin enters URLs in V1; upload comes later).
/// verifiedOrderItemId is a plain nullable column for now — no FK until the
/// customer-review flow exists.
model ProductReview {
  id                  String       @id @default(uuid(7)) @db.Uuid
  productId           String       @map("product_id") @db.Uuid
  source              ReviewSource @default(ADMIN)
  authorName          String       @map("author_name")
  location            String?
  rating              Int
  title               String?
  comment             String
  photos              String[]     @default([])
  // Merchant-entered option descriptor shown on the storefront, exactly as
  // Amazon prints "Color: ... | Size: ...". Free text: no SKU linkage in V1.
  variant             String?
  isVisible           Boolean      @default(true) @map("is_visible")
  verifiedOrderItemId String?      @map("verified_order_item_id") @db.Uuid
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  helpfulVotes ReviewHelpfulVote[]
  reports      ReviewReport[]

  @@index([productId, isVisible])
  @@map("product_reviews")
}

/// Anonymous "this review was helpful" votes. At most one row per
/// (review, visitor); the visitor carries a random cookie id and only its
/// salted SHA-256 hash is stored, so the table cannot identify shoppers.
model ReviewHelpfulVote {
  id          String   @id @default(uuid(7)) @db.Uuid
  reviewId    String   @map("review_id") @db.Uuid
  visitorHash String   @map("visitor_hash")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  review ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  // Composite unique doubles as the reviewId-prefix index for count queries.
  @@unique([reviewId, visitorHash])
  @@map("review_helpful_votes")
}

/// Shopper-submitted review reports (PDP "Report" link). One open report per
/// (review, visitor); a repeat report refreshes reason/createdAt. Merchants
/// inspect and clear these from the product's admin reviews page.
model ReviewReport {
  id          String   @id @default(uuid(7)) @db.Uuid
  reviewId    String   @map("review_id") @db.Uuid
  reason      String?
  visitorHash String   @map("visitor_hash")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  review ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, visitorHash])
  @@index([reviewId])
  @@map("review_reports")
}
