# Copy this file to .env and adjust for your machine:
#
#   cp .env.example .env
#
# Every variable here is validated at boot (src/config/env.validation.ts).
# A missing or malformed value stops the application at startup instead of
# failing later at request time.

# --- Application -----------------------------------------------------------
# development | test | production
NODE_ENV=development

# Port the HTTP server listens on.
PORT=3000

# Bind address. 127.0.0.1 keeps local dev LAN-invisible; leave 0.0.0.0
# inside the Docker image (the image ships no .env, so it uses the default).
HOST=127.0.0.1

# --- Database --------------------------------------------------------------
# Start the local database first: docker compose up -d
# (see docker-compose.yml at the repository root)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/small_house?schema=public"

# --- Authentication --------------------------------------------------------
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be at least 32 characters. Never commit the real value.
JWT_SECRET=change-me-generate-a-random-48-byte-secret

# Access token lifetime (vercel/ms format used by @nestjs/jwt).
JWT_ACCESS_TTL=1h

# Refresh token lifetime; every refresh rotates the token.
JWT_REFRESH_TTL=7d

# --- Initial admin (used by `prisma db seed` only) -------------------------
# Leave ADMIN_PASSWORD unset to have the seed generate and print a random one.
ADMIN_EMAIL=dev@smallhouse.test
# ADMIN_PASSWORD=
